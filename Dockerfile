# ==========================================================
# Dockerfile — інструкція для автоматичного створення образу
# контейнера Docker для Django-проєкту.
#
# Під час збірки Docker виконує команди зверху вниз.
# У результаті створюється готовий образ, який можна запускати
# на будь-якому комп'ютері або сервері, де встановлений Docker.
# ==========================================================


# ----------------------------------------------------------
# 1. Обираємо базовий образ
# ----------------------------------------------------------

# FROM — команда, яка визначає основу майбутнього контейнера.
#
# python:3.12-slim-bullseye означає:
#   python  -> офіційний образ Python;
#   3.12    -> використовується Python версії 3.12;
#   slim    -> полегшена версія Linux без зайвих програм;
#   bullseye-> версія Debian Linux (Debian 11).
#
# У цьому образі вже встановлено Python,
# тому його не потрібно встановлювати вручну.
FROM python:3.12-slim-bullseye


# ----------------------------------------------------------
# 2. Налаштовуємо Python
# ----------------------------------------------------------

# ENV створює змінні середовища всередині контейнера.

# PYTHONUNBUFFERED=1
#
# Python буде одразу виводити всі повідомлення у консоль.
#
# Без цієї змінної Docker може накопичувати текст
# і показувати його із затримкою.
#
# Особливо корисно для перегляду логів.
ENV PYTHONUNBUFFERED 1


# PYTHONDONTWRITEBYTECODE=1
#
# Забороняє Python створювати файли:
#
#     __pycache__/
#     *.pyc
#
# Це робить контейнер трохи "чистішим"
# і не займає зайве місце.
ENV PYTHONDONTWRITEBYTECODE 1


# ----------------------------------------------------------
# 3. Робоча папка
# ----------------------------------------------------------

# WORKDIR задає поточну папку контейнера.
#
# Якщо папки /app ще немає —
# Docker автоматично її створить.
#
# Після цього всі наступні команди
# будуть виконуватись саме всередині /app.
WORKDIR /app


# ----------------------------------------------------------
# 4. Встановлюємо системні пакети
# ----------------------------------------------------------

# RUN виконує Linux-команди під час збірки образу.
RUN apt-get update && apt-get install -y \
    # gcc — компілятор мов C/C++.
    #
    # Деякі Python-бібліотеки містять C-код
    # і потребують компіляції під час встановлення.
    #
    # Наприклад:
    # psycopg2
    # Pillow
    # numpy
    #
    # Без gcc такі бібліотеки можуть не встановитися.
    gcc \
    # Видаляємо кеш apt після встановлення.
    #
    # Це значно зменшує розмір Docker-образу.
    && rm -rf /var/lib/apt/lists/*


# ----------------------------------------------------------
# 5. Копіюємо requirements.txt
# ----------------------------------------------------------

# COPY копіює файл з вашого комп'ютера
# всередину Docker-контейнера.
#
# requirements.txt містить список
# усіх бібліотек Python.
#
# Копіюємо лише цей файл окремо,
# щоб Docker міг використовувати кеш.
#
# Якщо requirements.txt не змінився,
# Docker повторно не встановлюватиме бібліотеки,
# що значно пришвидшує збірку.
COPY requirements.txt /app/


# Встановлюємо всі бібліотеки.
#
# pip install читає requirements.txt
# і встановлює кожен пакет.
#
# --no-cache-dir
#
# Після встановлення видаляється кеш pip,
# тому образ стає меншим.
RUN pip install --no-cache-dir -r requirements.txt


# ----------------------------------------------------------
# 6. Копіюємо весь Django-проєкт
# ----------------------------------------------------------

# "." означає:
#     усі файли поточної папки.
#
# "/app/"
#     папка всередині контейнера.
#
# Після цієї команди всередині Docker
# буде знаходитися повна копія вашого проєкту.
COPY . /app/


# ----------------------------------------------------------
# 7. Збираємо статичні файли
# ----------------------------------------------------------

# Django має папки static
# у різних застосунках.
#
# Команда collectstatic збирає всі CSS,
# JavaScript, шрифти та зображення
# в одну загальну директорію STATIC_ROOT.
#
# Це потрібно для роботи на сервері.
#
# --noinput
# означає не ставити додаткових запитань.
RUN python manage.py collectstatic --noinput


# ----------------------------------------------------------
# 8. Відкриваємо порт
# ----------------------------------------------------------

# EXPOSE повідомляє Docker,
# що контейнер буде працювати
# через порт 8000.
#
# Сам порт ще не відкривається назовні —
# це лише інформація для Docker.
#
# При запуску контейнера
# порт потрібно буде пробросити:
#
# docker run -p 8000:8000
EXPOSE 8000


# ----------------------------------------------------------
# 9. Запуск контейнера
# ----------------------------------------------------------

# ENTRYPOINT визначає,
# яка команда автоматично виконається
# після запуску контейнера.
#
# Gunicorn — це WSGI-сервер,
# який використовується замість
# вбудованого Django runserver.
#
# "manga.wsgi"
# означає:
#     файл manga/wsgi.py
#
# Саме через нього Gunicorn запускає Django.
#
# "-b"
# означає bind (прив'язати сервер).
#
# "0.0.0.0:8000"
#
# Сервер слухатиме всі мережеві інтерфейси
# контейнера на порту 8000.
#
# Якщо ваш Django-проєкт називається
# не "manga", потрібно замінити:
#
#     manga.wsgi
#
# на:
#
#     назва_проєкту.wsgi
ENTRYPOINT ["gunicorn", "django_where.wsgi", "-b", "0.0.0.0:8000"]